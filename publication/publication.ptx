<?xml version="1.0" encoding="UTF-8" ?>
<publication>
    <!-- directories are relative to the main source PreTeXt file -->
    <!-- the external directory is declared in main.ptx "docinfo" -->
    <source customizations="../customizations/customizations.xml">
        <directories generated="../generated-assets"/>
    </source>

    <common>
    </common>

    <numbering>
        <divisions level="0"/>
        <blocks level="0"/>
        <footnotes level="0"/>
        <projects level="0"/>
        <equations level="0"/>
    </numbering>
    <html>
        <tableofcontents focused="yes" preexpanded-levels="1"/>
    </html>
</publication>
